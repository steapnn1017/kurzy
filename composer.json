{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "skola/kurzy-a-prihlasky",
    "type": "project",
    "description": "Kurzy a přihlašování účastníků. Školní aplikace v Laravelu. JSON neumí komentáře, proto je tento soubor vysvětlený v README.md (sekce composer.json).",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate:fresh --seed --force --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "scripts-descriptions": {
        "setup": "Připraví aplikaci: vytvoří .env, tajný klíč, soubor SQLite databáze a naplní databázi ukázkovými daty (stará data smaže)."
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
