# ======================================================================
# .env.example = VZOR nastavení aplikace.
# Příkaz `composer setup` ho zkopíruje do souboru .env a doplní APP_KEY.
# Soubor .env se do gitu nedává (je v .gitignore), obsahuje tajný klíč.
# Všechno, co tu není, má Laravel nastavené rozumně sám.
# ======================================================================

# local = vývoj na vlastním počítači (na serveru by tu bylo production)
APP_ENV=local
# Tajný klíč pro šifrování cookies. Vyplní ho `php artisan key:generate`
# (spouští se v rámci `composer setup`).
APP_KEY=
# true = při chybě se ukáže podrobný výpis s řádkem kódu (jen pro vývoj!)
APP_DEBUG=true

# Databáze SQLite = celá databáze je jeden soubor database/database.sqlite.
# Nepotřebuje databázový server, jméno ani heslo.
DB_CONNECTION=sqlite

# Session (hlášky po uložení, chyby formuláře, CSRF token) se ukládá
# zašifrovaně přímo do cookie v prohlížeči, takže nepotřebujeme
# žádnou složku ani tabulku navíc.
SESSION_DRIVER=cookie
# Cache aplikace nepoužívá, stačí jí paměť (array) po dobu jednoho požadavku
CACHE_STORE=array
